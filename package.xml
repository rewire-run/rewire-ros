<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rewire</name>
  <version>0.1.1</version>
  <description>Launch integration for rewire, a drop-in ROS 2 bridge for the Rerun viewer.</description>

  <maintainer email="alvgaona@gmail.com">Alvaro Gaona</maintainer>
  <license file="LICENSE">Apache-2.0</license>

  <url type="repository">https://github.com/rewire-run/rewire-ros</url>
  <url type="website">https://rewire.run</url>
  <url type="bugtracker">https://github.com/rewire-run/rewire-ros/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The bundled viewer links libudev. The build farm's dpkg-shlibdeps must find
       it in the build chroot to resolve the deb's runtime dependencies. -->
  <build_depend>libudev-dev</build_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
